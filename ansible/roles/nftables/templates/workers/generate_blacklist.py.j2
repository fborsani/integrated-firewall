#!/usr/bin/env python3

from abc import ABC, abstractmethod
from typing import TextIO
from pathlib import Path
import ipaddress


LOCAL_LISTS_IPV4 = {{ nftables.local_blacklists.ipv4 | default([]) | to_json }}
LOCAL_LISTS_IPV6 = {{ nftables.local_blacklists.ipv6 | default([]) | to_json }}

USER_BLOCKED_IPV4 = []
USER_BLOCKED_IPV6 = []

STAGING_FOLDER_IPV4 = "{{ nftables_staging_folder_ipv4 }}"
STAGING_FOLDER_IPV6 = "{{ nftables_staging_folder_ipv6 }}"

SET_NAME_IPV4 = "{{}}"
SET_NAME_IPV6 = "{{}}"

SET_NAME_USER_ENTRIES_IPV4 = "{{}}"
SET_NAME_USER_ENTRIES_IPV6 = "{{}}"

OUTPUT_FILE = "{{ nftables_work_dir }}/{{ nftables_root_table }}"

WORK_MODES = [
    ("IP4", LOCAL_LISTS_IPV4, STAGING_FOLDER_IPV4, USER_BLOCKED_IPV4, SET_NAME_IPV4, SET_NAME_USER_ENTRIES_IPV4, True),
    ("IP6", LOCAL_LISTS_IPV6, STAGING_FOLDER_IPV6, USER_BLOCKED_IPV6, SET_NAME_IPV6, SET_NAME_USER_ENTRIES_IPV6, False)
]


class EntryWorker(ABC):
    entry_str = "        {},\n"
    file_comment = "#       {},\n"

    def __init__(self, ipv4: bool):
        self.ipv4 = ipv4

    @abstractmethod
    def write(self, file: TextIO) -> None:
        pass

    def validate(self, entry: str) -> tuple[bool, str]:
        entry = entry.partition("#")[0].strip()

        if not entry:
            return False, ""

        try:
            network = ipaddress.ip_network(entry, strict=False)
        except ValueError:
            return False, ""

        expected_version = 4 if self.ipv4 else 6

        if network.version != expected_version:
            return False, ""

        return True, str(network)


class FileWorker(EntryWorker):
    def __init__(self, source_paths: list, ipv4: bool):
        super().__init__(ipv4)
        self.source_paths = source_paths

    def write(self, file: TextIO) -> None:
        for path in self.source_paths:
            with Path(path).open(encoding="utf-8") as source:
                file.write(self.file_comment.format(path))
                for line in source:
                    valid, out = self.validate(line)
                    if valid:
                        file.write(self.entry_str.format(out))


class ListWorker(EntryWorker):
  def __init__(self, entries: list, ipv4: bool):
    super().__init__(ipv4)
    self.entries = entries

  def write(self, file: TextIO) -> None:
    for entry in self.entries:
      valid, out = self.validate(entry)
      if valid:
        file.write(self.entry_str.format(out))


def write_set(file: TextIO, set_name: str, ipv4: bool, worker: EntryWorker):
    type_str = "ipv4_addr" if ipv4 else "ipv6_addr"

    file.write(f"set {set_name} {{\n")
    file.write(f"    type {type_str}\n")
    file.write("    flags interval\n")
    file.write("    auto-merge\n")
    file.write("    elements = {\n")
    worker.write(file)
    file.write("    }\n")
    file.write("}\n\n")


def main():
    output = Path(OUTPUT_FILE)
    with output.open("w", encoding="utf-8") as file:
        file.write("# Generated automatically; do not edit manually.\n\n")
        file.write("table inet blocklists {\n")
        for wk in WORK_MODES:
            tag, local_lists, remote_staging_folder, user_entries, set_name, user_defined_set_name, is_ipv4 = wk

            staging_folder = Path(remote_staging_folder)
            blocklists = list(local_lists)
            blocklists.extend(str(path) for path in staging_folder.iterdir() if path.is_file())

            file.write(f"    #-----{tag} blocklists-----\n")

            worker = FileWorker(blocklists, is_ipv4)
            write_set(file, set_name, is_ipv4, worker)
            
            if user_entries:
                worker = ListWorker(user_entries, is_ipv4)
                write_set(file, user_defined_set_name, is_ipv4, worker)
        file.write("}\n")


if __name__ == "__main__":
  main()