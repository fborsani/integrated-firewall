
table inet {{ nftables_dns_rule_table_name }} {
    set docker_nets {
        type ipv4_addr
        flags interval
        elements = {
            {{ pihole.subnet }}
        }
    }

    set pihole {
        type ipv4_addr
        elements = {
            {{ pihole.resolver_ipv4_address }}
        }
    }

    chain input {
        type filter hook input priority filter; policy accept;

        ip saddr @pihole udp sport 53 accept
        ip saddr @pihole tcp sport 53 accept

        udp dport 53 drop
        tcp dport 53 drop

        tcp dport 853 drop
        udp dport 853 drop
    }

    chain output {
        type filter hook output priority filter; policy accept;

        ip daddr @pihole udp dport 53 accept
        ip daddr @pihole tcp dport 53 accept

        udp dport 53 drop
        tcp dport 53 drop

        tcp dport 853 drop
        udp dport 853 drop
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        ip saddr @docker_nets ip daddr @pihole udp dport 53 accept
        ip saddr @docker_nets ip daddr @pihole tcp dport 53 accept

        ip saddr @pihole ip daddr @docker_nets udp sport 53 accept
        ip saddr @pihole ip daddr @docker_nets tcp sport 53 accept

        ip saddr @docker_nets udp dport 53 drop
        ip saddr @docker_nets tcp dport 53 drop

        # Block DoT everywhere through the host
        tcp dport 853 drop
        udp dport 853 drop
    }
}