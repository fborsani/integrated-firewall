#!/usr/bin/env python3

import pathlib
import shutil
import sys
from urllib.parse import urlparse, urlunparse


#=========================================
#==========MANAGED BY ANSIBLE=============
BL_REMOTE_SOURCES = {{ pihole.blacklists.remote | to_json }}
BL_LOCAL_SOURCES = {{ blacklist_files | to_json }}
WL_REMOTE_SOURCES = {{ pihole.whitelists.remote | to_json }}
WL_LOCAL_SOURCES = {{ whitelist_files | to_json }}

MANAGED_LISTS_COMMENT = "{{ pihole_managed_list_comment }}"

BLACKLIST_SERVER = "http://{{ pihole_list_server_name }}:{{ pihole_list_server_port | string }}"
BLACKLIST_SERVER_STORAGE_FOLDER = "{{ pihole_rule_files_staging_folder }}"
GENERATED_SQL_PATH = "{{ pihole_docker_sql_volume }}/{{ pihole_docker_sql_file }}"
#=========================================

SQL_INSERT_STATEMENT = "INSERT INTO adlist (address, enabled, type, comment) VALUES ({0}, 1, {1}, {2});"
SQL_TYPE_BLACKLIST = "0"
SQL_TYPE_WHITELIST = "1"


def validate_remote_resources(input: list[str]) -> list[str] :
    output = []

    for url in input:
        if isinstance(url, str):
            url = url.strip()
            parsed = urlparse(url)

            if parsed.scheme in {"http", "https"} and parsed.netloc:
                normalized_url = urlunparse((
                    parsed.scheme.lower(),
                    parsed.netloc,
                    parsed.path or "/",
                    parsed.params,
                    parsed.query,
                    parsed.fragment,
                ))

                output.append(normalized_url)

    return list(set(output))


def generate_local_url(local_path: str, whitelist: bool) -> dict :
    prefix = "wl" if whitelist else "bl"
    uri=prefix+"_"+local_path.strip().lstrip("/").replace(" ", "").replace("/", "-")
    return {
        "url": f"{BLACKLIST_SERVER.rstrip("/")}/{uri}",
        "copy_dest": f"{BLACKLIST_SERVER_STORAGE_FOLDER.rstrip("/")}/{uri}"
    }


def ingest_local_lists(paths: list[str], whitelist: bool) -> list[str] :
    output = []
    for path in paths:
        file = pathlib.Path(path)
        if file.is_file() and file.stat().st_size > 0:
            path_data = generate_local_url(path, whitelist)
            output.append(path_data["url"])
            shutil.copy(path, path_data["copy_dest"])

    return output


def sql_quote(value: str) -> str:
    return "'" + value.replace("'", "''") + "'"


def generate_sql_transaction(whitelist: list[str], blacklist: list[str]) -> None:
    lines = [
        "-- Automatically generated by pihole-blacklist-sync",
        "-- DO NOT EDIT",
        "",
        "BEGIN TRANSACTION;",
        "",
        f"DELETE FROM gravity WHERE adlist_id IN (SELECT id FROM adlist  WHERE comment = {sql_quote(MANAGED_LISTS_COMMENT)});",
        f"DELETE FROM antigravity WHERE adlist_id IN (SELECT id FROM adlist WHERE comment = {sql_quote(MANAGED_LISTS_COMMENT)});",
        f"DELETE FROM adlist WHERE comment = {sql_quote(MANAGED_LISTS_COMMENT)};",
        "",
    ]

    if blacklist:
        lines.extend([
            "",
            "--- BLACKLISTS ---",
            "" 
        ])

        for url in blacklist:
            lines.append(SQL_INSERT_STATEMENT.format(sql_quote(url), SQL_TYPE_BLACKLIST, sql_quote(MANAGED_LISTS_COMMENT)))

    if whitelist:
        lines.extend([
            "",
            "--- WHITELISTS ---",
            ""
        ])

        for url in whitelist:
            lines.append(SQL_INSERT_STATEMENT.format(sql_quote(url), SQL_TYPE_WHITELIST, sql_quote(MANAGED_LISTS_COMMENT)))

    lines.extend(
        [
            "",
            "COMMIT;",
            "",
        ]
    )

    dest_file = pathlib.Path(GENERATED_SQL_PATH)
    sql_content = "\n".join(lines)
    print(f"[+] Generated SQL file\n{sql_content}", file=sys.stdout)
    dest_file.write_text(sql_content, encoding="utf-8")


def main():
    if WL_LOCAL_SOURCES or BL_LOCAL_SOURCES:
        if not (BLACKLIST_SERVER_STORAGE_FOLDER and pathlib.Path(BLACKLIST_SERVER_STORAGE_FOLDER).is_dir()):
            print(f"[-]: Local sources are present but the staging folder is undefined or does not exist. Received value: \"{BLACKLIST_SERVER_STORAGE_FOLDER}\"", file=sys.stderr)
            sys.exit(1)

    if not pathlib.Path(GENERATED_SQL_PATH).parent.is_dir():
        print(f"[-]: SQL Destination folder not found. Expected to write in path \"{GENERATED_SQL_PATH}\"", file=sys.stderr)
        sys.exit(1)
        
    try:
        whitelist = (validate_remote_resources(WL_REMOTE_SOURCES) + ingest_local_lists(WL_LOCAL_SOURCES, True))
        blacklist = (validate_remote_resources(BL_REMOTE_SOURCES) + ingest_local_lists(BL_LOCAL_SOURCES, False))

        print(f"[+] Detected whitelists: {len(whitelist)}\n{whitelist}", file=sys.stdout)
        print(f"[+] Detected blacklists: {len(blacklist)}\n{blacklist}", file=sys.stdout)

        generate_sql_transaction(whitelist, blacklist);
    except Exception as e:
        print(f"[-]: Exception {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    sys.exit(main())
